{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.local/schemas/figma-evidence-package.schema.json",
  "title": "A2UI Figma Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "source", "artifacts", "gate"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "runId": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "fileKey", "nodeId", "capturedAt", "tool"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://(?:www\\.)?figma\\.com/design/"},
        "fileKey": {"type": "string", "minLength": 1},
        "nodeId": {"type": "string", "pattern": "^[0-9]+[:\\-][0-9]+$"},
        "capturedAt": {"type": "string", "format": "date-time"},
        "tool": {"const": "figma-mcp"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designContext", "screenshot", "variables", "codeConnect", "assets"],
      "properties": {
        "designContext": {"$ref": "#/$defs/artifact"},
        "screenshot": {"$ref": "#/$defs/artifact"},
        "variables": {"$ref": "#/$defs/artifact"},
        "codeConnect": {"$ref": "#/$defs/artifact"},
        "assets": {"$ref": "#/$defs/artifact"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "status", "checks", "issues"],
      "properties": {
        "gateId": {"const": "FigmaSourceGate"},
        "status": {"enum": ["passed", "needs-review", "blocked", "failed"]},
        "checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "sha256", "status"],
      "properties": {
        "artifactRef": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "status": {"enum": ["captured", "persisted", "missing", "needs-review"]},
        "temporarySource": {"type": "boolean"}
      }
    }
  }
}
