{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.local/schemas/a2ui-reverse-output.schema.json",
  "title": "A2UI Reverse Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "projectId", "sourceRef", "sourceHash", "status", "observationsRef", "sheetA", "sheetB", "gateResults", "issues"],
  "properties": {
    "runId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "sourceRef": {"type": "string", "minLength": 1},
    "sourceHash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "status": {"enum": ["candidate", "needs-review", "passed", "blocked"]},
    "observationsRef": {"type": "string", "minLength": 1},
    "sheetA": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "sheetB": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "renderSpec": {"type": ["object", "null"]},
    "gateResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "status", "checks", "issues"],
        "properties": {
          "gateId": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "needs-review", "blocked", "failed", "skipped"]},
          "checks": {"type": "array", "items": {"type": "string"}},
          "issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "issues": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceProperties": {
      "type": "object",
      "properties": {
        "sourceObservationIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["candidate", "needs-review", "approved", "rejected"]}
      },
      "required": ["sourceObservationIds", "confidence", "status"]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "level", "min", "max", "accepts", "emptyPolicy", "children"],
      "properties": {
        "slotId": {"type": "string", "pattern": "^slot-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "level": {"type": "integer", "minimum": 1, "maximum": 3},
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 1},
        "accepts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "emptyPolicy": {"enum": ["collapse", "preserve", "fallback"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/slot"}}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "baseClass", "variant", "layoutMode", "slots", "dataRequirements", "actionRequirements", "guardrails", "registryStatus", "sourceObservationIds", "confidence", "status"],
      "properties": {
        "componentId": {"type": "string", "pattern": "^a2-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "baseClass": {"type": "string", "pattern": "^a2-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "variant": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "layoutMode": {"enum": ["vertical", "horizontal", "grid", "overlay", "stack"]},
        "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
        "dataRequirements": {"type": "array", "items": {"type": "string"}},
        "actionRequirements": {"type": "array", "items": {"type": "string"}},
        "guardrails": {"type": "object"},
        "registryStatus": {"enum": ["unmatched", "matched", "candidate", "needs-review"]},
        "sourceObservationIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["candidate", "needs-review", "approved", "rejected"]}
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenName", "cssVariable", "category", "rawValue", "compiledValue", "snapPolicy", "sourceObservationIds", "confidence", "status"],
      "properties": {
        "tokenName": {"type": "string", "pattern": "^component\\.a2-[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
        "cssVariable": {"type": "string", "pattern": "^--component-a2-[a-z0-9-]+$"},
        "category": {"enum": ["color", "spacing", "radius", "typography", "border", "shadow", "motion", "size", "layout"]},
        "rawValue": {},
        "compiledValue": {},
        "snapPolicy": {"enum": ["none", "spacing-4px", "radius-4px", "project-contract"]},
        "sourceObservationIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["candidate", "needs-review", "approved", "rejected"]}
      }
    }
  }
}
